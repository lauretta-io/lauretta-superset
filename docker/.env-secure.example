#
# Template for docker/.env-secure — the environment file for the hardened
# deployment (docker-compose-secure.yml).
#
#   ./scripts/generate-secure-secrets.sh        # writes docker/.env-secure for you
#
# ...or copy this file and fill in every <placeholder> by hand:
#
#   cp docker/.env-secure.example docker/.env-secure
#   chmod 600 docker/.env-secure
#
# docker/.env-secure is gitignored. This template must only ever contain
# placeholders. Loaded *after* docker/.env, so everything here wins.
#
# Note that docker-compose-secure.yml deliberately does NOT load
# docker/.env-local — local dev overrides must not reach a secure deployment.
#

# ---------------------------------------------------------------------------
# Mode switches — these are what turn the hardening on
# ---------------------------------------------------------------------------
# Loads docker/pythonpath_secure/superset_config_secure.py. Without it the stack
# runs with development defaults.
SUPERSET_SECURE_MODE=true

# Must include /app/docker/pythonpath_secure or the import above fails.
PYTHONPATH=/app/pythonpath:/app/docker/pythonpath_dev:/app/docker/pythonpath_secure

# FLASK_DEBUG=true makes Superset serve TALISMAN_DEV_CONFIG, whose CSP allows
# 'unsafe-inline' and 'unsafe-eval' (superset/initialization/__init__.py:617).
# Leave all three of these exactly as they are.
FLASK_DEBUG=false
DEV_MODE=false
SUPERSET_ENV=production

SUPERSET_LOAD_EXAMPLES=no
CYPRESS_CONFIG=false
SUPERSET_LOG_LEVEL=warning

# Public HTTPS URL served by the host nginx. Must be https:// — the secure config
# refuses to start otherwise. Used for report/alert links.
SUPERSET_PUBLIC_URL=https://superset.example.com

# ---------------------------------------------------------------------------
# Secrets — generate every one of these uniquely
# ---------------------------------------------------------------------------
# openssl rand -base64 42
#
# READ THIS BEFORE CHANGING SUPERSET_SECRET_KEY ON AN EXISTING INSTANCE. The key
# encrypts the stored passwords of every database connection Superset knows about.
# Changing it on a stack that already has connections makes them undecryptable —
# they fail with a decryption error, not a clear message.
#
# On a fresh instance (no database connections saved yet): just set it.
#
# On an existing instance, re-encrypt rather than just replace.
#
# Keep a note of the old key, set the new one below, then:
#
#   docker compose -f docker-compose-secure.yml up -d db redis
#   docker compose -f docker-compose-secure.yml run --rm --no-deps superset superset re-encrypt-secrets --previous_secret_key '<the old key>'
#   docker compose -f docker-compose-secure.yml up -d
#
# This also works as a recovery if you already restarted and superset_init_secure is
# failing with "ValueError: Invalid decryption key" — superset_app_secure waits on
# init, so it never starts and you cannot exec into it. re-encrypt-secrets reads the
# columns with raw SQL and never hits the ORM path that throws. Take a backup first:
#
#   docker compose -f docker-compose-secure.yml exec -T db \
#     pg_dump -U superset -d superset > superset-before-rotate.sql
#
# Back this value up somewhere outside this repo. Lose it and every saved database
# connection has to be re-entered by hand.
SUPERSET_SECRET_KEY=<openssl rand -base64 42>

# Postgres. DATABASE_PASSWORD and POSTGRES_PASSWORD must match: the first is what
# Superset connects with, the second is what the postgres image initialises.
DATABASE_PASSWORD=<openssl rand -base64 32 | tr -d '/+='>
POSTGRES_PASSWORD=<same value as DATABASE_PASSWORD>

# Redis. Enforced via `redis-server --requirepass`.
REDIS_PASSWORD=<openssl rand -base64 32 | tr -d '/+='>

# Initial admin password. docker-init.sh refuses to run in secure mode if this is
# unset or left as "admin". Change it again from the UI after first login.
ADMIN_PASSWORD=<openssl rand -base64 24 | tr -d '/+='>

# Signing key for embedded-dashboard guest tokens. Superset's default is the
# literal string "test-guest-secret-change-me", so this must be set even if you
# never enable embedding.
GUEST_TOKEN_SECRET=<openssl rand -base64 42>

# ---------------------------------------------------------------------------
# Email (SMTP) for alerts and reports — optional
# ---------------------------------------------------------------------------
# Uncomment and fill in the whole block to enable email. All SMTP settings live
# here, not in docker/.env — that file is tracked by git. Leave the block
# commented out and Superset simply never sends mail.
#
# SMTP_USER/SMTP_PASSWORD are only needed if your relay requires authentication;
# Superset skips the SMTP login when either is empty.
#
# SMTP_MAIL_FROM must be a full address — it is split on "@" when the report is
# sent, so a bare username fails there rather than at startup.

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_SSL_SERVER_AUTH=true
# SMTP_SSL=false
# SMTP_USER=<smtp-username>
# SMTP_PASSWORD=<smtp-password>
# SMTP_MAIL_FROM=noreply@example.com
# EMAIL_REPORTS_SUBJECT_PREFIX=[Superset]

# ---------------------------------------------------------------------------
# Examples database
# ---------------------------------------------------------------------------
# No example data is loaded (that block is commented out in docker-init.sh), but
# docker-entrypoint-initdb.d/examples-init.sh unconditionally creates this role at
# first DB init and fails if the vars are missing. Throwaway values are fine —
# nothing connects with them.
EXAMPLES_DB=examples
EXAMPLES_HOST=db
EXAMPLES_PORT=5432
EXAMPLES_USER=examples
EXAMPLES_PASSWORD=<openssl rand -base64 32 | tr -d '/+='>

# ---------------------------------------------------------------------------
# Gunicorn
# ---------------------------------------------------------------------------
# run-server.sh defaults both request limits to 0, i.e. unlimited request line and
# header size — a denial-of-service finding. These are gunicorn's own defaults.
SERVER_LIMIT_REQUEST_LINE=4094
SERVER_LIMIT_REQUEST_FIELD_SIZE=8190

# Roughly (2 x cores) + 1. Tune to the host.
SERVER_WORKER_AMOUNT=4
SERVER_THREADS_AMOUNT=20
GUNICORN_TIMEOUT=120

# Recycle workers periodically to bound the effect of any memory leak. Jitter stops
# every worker restarting at once.
WORKER_MAX_REQUESTS=2000
WORKER_MAX_REQUESTS_JITTER=200

# ---------------------------------------------------------------------------
# Celery
# ---------------------------------------------------------------------------
CELERYD_CONCURRENCY=4
