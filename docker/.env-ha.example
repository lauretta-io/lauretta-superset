#
# Template for the HA-mode container environment (docker-compose-ha.yml). See
# lauretta/docs/11-ha-mode.md.
#
#   cp docker/.env-ha.example docker/.env-ha.local     # gitignored (docker/*local*)
#   chmod 600 docker/.env-ha.local
#
# Or keep the file anywhere and point SUPERSET_HA_ENV_FILE at it. It must be the SAME
# on every node: the secret key signs sessions and encrypts stored database passwords,
# so a node with another key logs users out and cannot open the data sources.
#
# Loaded after docker/.env. The mode switches (SUPERSET_SECURE_MODE, PYTHONPATH,
# SUPERSET_CONFIG_PATH, FLASK_DEBUG, ...) are fixed by the compose file and cannot be
# changed here. This template must only ever contain placeholders.

# ---------------------------------------------------------------------------
# Secrets (secure mode rules: superset_config_secure.py refuses placeholders)
# ---------------------------------------------------------------------------
SUPERSET_SECRET_KEY=<openssl rand -base64 42>
GUEST_TOKEN_SECRET=<openssl rand -base64 42>
REDIS_PASSWORD=<openssl rand -base64 32 | tr -d '/+='>
# Used by docker/docker-init-ha.sh only, when it creates the admin user.
ADMIN_PASSWORD=<openssl rand -base64 24 | tr -d '/+='>
# The name users type, e.g. https://superset.example.com (no port if 443).
SUPERSET_PUBLIC_URL=https://superset.example.com

# ---------------------------------------------------------------------------
# Metadata database: one PostgreSQL that fails over between hosts
# ---------------------------------------------------------------------------
DATABASE_USER=superset
DATABASE_PASSWORD=<openssl rand -base64 32 | tr -d '/+='>
DATABASE_DB=superset
# Every host that can be the writable server, comma-separated, in the order to try.
# These are the names the servers' certificates are verified against (verify-full).
DATABASE_HOSTS=pg-a.example.internal,pg-b.example.internal
# Optional: their addresses, same order. libpq then connects by address and does no
# DNS lookup, but still verifies each certificate against the name above.
DATABASE_HOSTADDRS=192.0.2.11,192.0.2.12
DATABASE_PORT=5432
# Optional (defaults shown). verify-full is the only setting this mode is tested with.
#DATABASE_SSLMODE=verify-full
#DATABASE_CONNECT_TIMEOUT=3
#DATABASE_POOL_RECYCLE=120
# Per gunicorn worker; see the connection arithmetic in superset_config_ha.py.
#DATABASE_POOL_SIZE=5
#DATABASE_MAX_OVERFLOW=5
#DATABASE_APPLICATION_NAME=superset-ha

# ---------------------------------------------------------------------------
# Optional sizing (as in .env-secure.example)
# ---------------------------------------------------------------------------
#SUPERSET_LOG_LEVEL=warning
#SERVER_WORKER_AMOUNT=4
#SERVER_THREADS_AMOUNT=20
#GUNICORN_TIMEOUT=120
#WORKER_MAX_REQUESTS=2000
#WORKER_MAX_REQUESTS_JITTER=200
#SERVER_LIMIT_REQUEST_LINE=4094
#SERVER_LIMIT_REQUEST_FIELD_SIZE=8190

# ---------------------------------------------------------------------------
# One-shot init only
# ---------------------------------------------------------------------------
#ADMIN_USERNAME=admin
# yes: docker-init-ha.sh also runs the Lauretta dashboard import
# (lauretta/dashboards/config.json, see 04-dashboards-and-floor-maps.md).
#HA_IMPORT_DASHBOARDS=no
